# Copy to .env and fill in. .env is gitignored — never commit real values.
# Nothing in this file may ever be shipped to the Flutter app.

PORT=3000
NODE_ENV=development

# --- Firebase (app-user authentication) -------------------------------------
# The same Firebase project the Gurukul app signs in against. The API verifies
# the app's ID tokens with it; there is no second login system.
FIREBASE_PROJECT_ID=
# Supply the service account one of three ways (first non-empty wins):
#   1. FIREBASE_SERVICE_ACCOUNT_JSON — the JSON inline (handy for PaaS secrets)
#   2. FIREBASE_SERVICE_ACCOUNT_PATH — path to the JSON file
#   3. neither, and GOOGLE_APPLICATION_CREDENTIALS / workload identity is used
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Cloudflare R2 credentials ----------------------------------------------
# Server-only. An R2 API token scoped to *read* the video bucket is enough for
# playback; add write only if this instance also handles uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Buckets ----------------------------------------------------------------
# One variable per bucket registered in src/config/buckets.ts. Adding a bucket
# means adding an entry there and a variable here.
R2_BUCKET_VIDEOS=

# How long a playback URL stays valid, in seconds. R2 allows up to 604800 (7d);
# keep it short — it is the window in which a leaked URL is usable.
VIDEO_URL_EXPIRATION_SECONDS=1800

# --- Playback rate limit ----------------------------------------------------
# Applied per authenticated user and per IP. Sized for real viewing (a video
# needs one grant plus the odd refresh), not for scripted URL harvesting.
PLAYBACK_RATE_LIMIT_MAX=30
PLAYBACK_RATE_LIMIT_WINDOW_SECONDS=60

# --- App Check (app attestation) ---------------------------------------------
# Proves a request came from a genuine Gurukul build (Play Integrity on Android,
# App Attest on iOS). This attests the APP, not the user — it does not gate
# anonymous sessions, and story videos stay watchable without signing up.
# Roll out with this off: requests are verified and logged but still served. Turn
# it on once the logs show real devices attesting successfully.
APP_CHECK_ENFORCED=false

# --- Operator token ---------------------------------------------------------
# Guards POST /api/videos/upload-url, used when publishing new videos. Not an
# app credential: it is never given to the Flutter client.
ADMIN_API_TOKEN=
